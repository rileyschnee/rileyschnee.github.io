---
import BaseLayout from "../layouts/BaseLayout.astro";
import { IDENTITY, SITE_METADATA } from "../constants.js";

const { gameTitle, gameSrc, type, bgColor } = Astro.props;
---

<BaseLayout pageTitle={gameTitle}>
    <h1 style="text-align:center;">{gameTitle}</h1>
    <div class="page-center-wrapper">
        {
            type == "game" && (
                <div class="mobile-game-warning">
                    <p>
                        ⚠️ Desktop Only: This game requires a keyboard or
                        controller to play. <br /> Touch controls are not
                        supported beyond the menu!
                    </p>
                </div>
            )
        }
        <div class="game-display-box" style={`--game-bg: ${bgColor};`}>
            {
                type === "yt" && (
                    <iframe
                        class="yt"
                        src={gameSrc}
                        title="YouTube video player"
                        frameborder="0"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        referrerpolicy="strict-origin-when-cross-origin"
                        allowfullscreen
                    />
                )
            }
            {
                type == "game" && (
                    <iframe
                        class="game"
                        src={gameSrc}
                        max-width="960"
                        max-height="640"
                        allow="autoplay; fullscreen"
                        scrolling="no"
                        style="border: none; margin: 0; padding: 0;"
                        allowfullscreen
                    />
                )
            }
        </div>
        <slot />
    </div>
</BaseLayout>

<style>
    .game-display-box {
        width: 95%;
        max-width: 960px;
        background-color: var(--game-bg);
        box-shadow: var(--cornerless-dropbox-border-med);
        padding: auto;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }
    iframe {
        width: 100%;
        height: 100%;
    }
    iframe.game {
        aspect-ratio: 16/11.5 !important;
    }
    iframe.yt {
        aspect-ratio: 560/340 !important; /* 560 x 315 is the embed dimensions */
        padding: 20px 20px;
    }

    .mobile-game-warning {
        display: inline-block;
        text-align: center;
    }
    @media screen and (min-width: 636px) {
        .mobile-game-warning {
            display: none;
        }
    }
</style>
