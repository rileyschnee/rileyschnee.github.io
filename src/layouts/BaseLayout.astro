---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_METADATA } from "../constants";
import Fortune from "../components/Fortune.astro";
import GoogleAnalytics from '../components/GoogleAnalytics.astro';

const { pageTitle } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="public/ligature_bw.svg" type="image/svg+xml" />
		<link rel="icon" href="public/ligature_bw.png" type="image/png" sizes="96x96">
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{SITE_METADATA.title}</title>
		<GoogleAnalytics />
	</head>
	<body>
		<Header />
		<main>
			<Fortune />
			<slot />
		</main>
		<Footer />
	</body>
</html>
