---
import Image from "astro/components/Image.astro";
import LinkButton from "./LinkButton.astro";

export interface ExperienceEntry {
    company: string;
    team: string;
    role: string;
    when: string;
    where?: string;
    details?: string[] | string;
    type?: "professional" | "intern" | "high school";
    tags?: string[];
}

const { exp } = Astro.props;
---

<div class="pixel-box" style="max-width: 600px;">
    <h3>{exp.role} | {exp.company} - {exp.team}</h3>
    <p>{exp.when} | {exp.where}</p>
    {
        typeof exp.details === "string" ? (
            // Single string
            <p style="line-height: 1rem;">{exp.details}</p>
        ) : (
            // If it's a list, use bullets
            <ul>
                {exp.details.map((detail: string) => (
                    <li>{detail}</li>
                ))}
            </ul>
        )
    }
    { exp.tags &&
        (
            <p>
                {exp.tags.map((tag: string, index: number) => (
                    <>
                        <span>{tag}</span>
                        {index < exp.tags.length - 1 && <span> ✴︎ </span>}
                    </>
                ))}
            </p>
        )
    }
</div>
