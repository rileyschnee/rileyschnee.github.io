---
import Image from "astro/components/Image.astro";
import crystal_ball_hover from "../assets/art/crystal_ball_glow_1000.png";
import crystal_ball from "../assets/art/crystal_ball_default_1000.png";
---

<button class="crystal-ball-btn" id="crystal-ball">
    <Image
        src={crystal_ball}
        alt="crystal ball icon"
        class="pixel-art img-default ratio-1-1"
    />
    <Image
        src={crystal_ball_hover}
        alt="glowing crystal ball icon"
        class="pixel-art img-hover ratio-1-1"
    />
</button>

<style>
    .crystal-ball-btn {
        width: 64px;
        height: 64px;
        aspect-ratio: 1;
        margin-right: 10px;
        position: relative; 
        display: block;
        padding: 0;
        cursor: pointer;
        border: none;
        background: transparent;
    }
    .crystal-ball-btn img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        transition: opacity 0.2s ease-in-out;
    }
    .crystal-ball-btn img.img-default {
        opacity: 1;
        z-index: 2;
    }
    /* Hide the hover image by default */
    .crystal-ball-btn img.img-hover {
        opacity: 0;
        z-index: 1;
    }
    /* Desktop only: prevent the crystal ball from looking active on first tap */
    @media (hover: hover) {
        /* When hovered, switch visibility */
        .crystal-ball-btn:hover img.img-default {
            opacity: 0;
        }
        .crystal-ball-btn:hover img.img-hover {
            opacity: 1;
            z-index: 3;
        }
    }
    /* Allows me to keep hover-like state during fortune-telling */
    .is-scrying img.img-default {
        opacity: 0 !important;
    }
    .is-scrying img.img-hover {
        opacity: 1 !important;
        z-index: 3 !important;
    }
</style>
