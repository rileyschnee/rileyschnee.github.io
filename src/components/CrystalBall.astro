---
import Image from "astro/components/Image.astro";
import crystal_ball_hover from "../assets/art/crystal_ball_hover.png";
import crystal_ball from "../assets/art/crystal_ball_default.png";
---

<button class="crystal-ball-btn">
    <Image
        src={crystal_ball}
        alt="crystal ball icon"
        class="pixel-art img-default"
    />
    <Image
        src={crystal_ball_hover}
        alt="glowing crystal ball icon"
        class="pixel-art img-hover"
    />
</button>
