---
import Image from "astro/components/Image.astro";
import crystal_ball_hover from "../assets/art/crystal_ball_glow_1000.png";
import crystal_ball from "../assets/art/crystal_ball_default_1000.png";
---

<button class="crystal-ball-btn">
    <Image
        src={crystal_ball}
        alt="crystal ball icon"
        class="pixel-art img-default w-64 ratio-1-1"
    />
    <Image
        src={crystal_ball_hover}
        alt="glowing crystal ball icon"
        class="pixel-art img-hover w-64 ratio-1-1"
    />
</button>

<style>
    .crystal-ball-btn {
        width: 64px;
        height: 64px;
        margin-right: 10px;
        display: block;
        align-items: center;
        justify-content: center;
        padding: 0;
        cursor: pointer;
        border: none;
    }
    /* Hide the hover image by default */
    .crystal-ball-btn img.img-hover {
        display: none !important;
    }
    .crystal-ball-btn img.img-default {
        display: block !important;
    }
    /* When hovered, switch visibility */
    .crystal-ball-btn:hover img.img-default {
        display: none !important;
    }
    .crystal-ball-btn:hover img.img-hover {
        display: block !important;
    }
</style>
