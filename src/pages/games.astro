---
import BaseLayout from "../layouts/BaseLayout.astro";
import { IDENTITY, SITE_METADATA } from "../constants.js";

import LinkButton from "../components/LinkButton.astro";
import Image from "astro/components/Image.astro";

import monster from "../assets/art/dungeon_monster_1000.png";
import witch from "../assets/art/witch.png";
import rupee from "../assets/art/rupee.png";

const pageTitle = "Games";
---

<BaseLayout pageTitle={pageTitle}>
    <h1 style="text-align:center; font-style:italic;">Shall we play a game?</h1>

	<div class="box-group">
		<!-- Star Witch Card -->
		<div class="pixel-box" style="max-width: 600px;">
			<Image
				src={witch}
				alt="star witch pixel art"
				class="pixel-art img-float-right w-64 ratio-1-2"
				style="transform: scaleX(-1); margin-right: 15px; margin-bottom: 10px;"
			/>
			<h2>Star Witch</h2>
			<p>Engineer & Technical Art, Lunar Ladies Studio | Unity (2D)</p>
			<div class="link-row">
				<LinkButton name="Watch trailer" url="/star-witch" />
				<LinkButton
					name="View on Itch.io"
					url="https://lunarladiesstudio.itch.io/star-witch"
				/>
			</div>
			<p></p>
			<p style="line-height: 1.5rem;">
				Star Witch is a whimsical, 2D puzzle-platforming adventure game.
				Travel the galaxy, visit peculiar planets, and wield your magic
				powers to save the quirky creatures that inhabit them from the
				Chaos Witch and her minions! Your spellbook is powerful, but be
				careful - with new ecosystems come new challenges. You must
				adapt in order to protect the citizens of the galaxy!
			</p>
			<p style="line-height: 1.5rem;">
				Lunar Ladies Studio was our team of four students from the
				University of Michigan. During the Fall 2020 semester, we
				developed Star Witch for EECS 494: Game Development. Star Witch
				won 3rd place at the Winter 2020 class showcase!
			</p>
			<a
				href="https://www.indiedb.com/games/star-witch"
				title="View Star Witch on IndieDB"
				><img
					src="https://button.indiedb.com/popularity/medium/games/75174.png"
					alt="Star Witch"
				/></a
			>
			<p style="line-height: 1.5rem;">
				Project #3 (6 weeks, 4 person team) for EECS 494: Video Game
				Development
			</p>
		</div>
		<!-- Welcome to the Dungeon Card -->
		<div class="pixel-box" style="max-width: 600px;">
			<Image
				src={monster}
				alt="dungeon monster pixel art"
				class="pixel-art img-float-right w-128 ratio-1-1"
				style="margin-bottom: -15px;"
			/>
			<h2>Welcome to the Dungeon</h2>
			<p>Solo Developer | Unity (3D) </p>
			<div class="link-row">
				<LinkButton name="Play now" url="/welcome-to-the-dungeon" />
			</div>
			<p></p>
			<p style="line-height: 1.5rem;">
				Meet Monty. He was recently hired by the Dungeon Master to
				handle clean up after the daring parties that venture into their
				domain...which means disposing of the bodies and re-arming the
				traps that led to their demise! If he fails to get everything
				back in order before the DM checks in...well...let's hope it
				doesn't come to that...
			</p>
			<p style="line-height: 1.5rem;">
				Fun fact: My parents and sister performed the voice acting for
				the perishing adventurers! ...On that morbid note, good luck with
				the clean up!
			</p>
			<p style="line-height: 1.5rem;">
				Project #2 (2 weeks, solo) for EECS 494: Video Game Development
			</p>
		</div>
		<!-- LOZ Card -->
		<div class="pixel-box" style="max-width: 600px;">
			<Image
				src={rupee}
				alt="zelda pixel art"
				class="pixel-art img-float-right w-32"
				style="margin-top: 25px; margin-right: 30px; margin-bottom: 10px;"
			/>
			<h2>Legend of Zelda (NES) Dungeon Remake</h2>
			<p>Handmaidens of Hyrule | Unity (2D)</p>
			<!-- <div class="link-row"></div> -->
			<p></p>
			<p style="line-height: 1.5rem;">
				Rebuilt the first dungeon from the original Legend of Zelda,
				aiming for an exact remake with a unique twist.
			</p>
			<p style="line-height: 1.5rem;">
				Project #1 (2 weeks, 2 person team) for EECS 494: Video Game
				Development
			</p>
		</div>
	</div>
</BaseLayout>
