---
import BaseLayout from "../layouts/BaseLayout.astro";
import { IDENTITY, SITE_METADATA } from "../constants.js";

const pageTitle = "Games";
---

<BaseLayout pageTitle={pageTitle}>
	<h2 style="text-align:center;">My completed (& playable) games:</h2>

	<!-- Responsive Grid: 1 column on mobile, 2 columns on desktop -->
	<div class="box-group">
		<!-- Welcome to the Dungeon Card -->
		<div class="pixel-box">
			<h3>Welcome to the Dungeon</h3>
			<p>Solo Developer | Unity (3D C#)</p>
			<a href="https://rileyschnee.github.io/welcome-to-the-dungeon-build"
				>Play Build</a
			>
		</div>

		<!-- Star Witch Card -->
		<div class="pixel-box">
			<h3>Star Witch</h3>
			<p>Engineer & Technical Art | Unity (2D C#)</p>
			<a href="https://lunarladiesstudio.itch.io/star-witch"
				>View on Itch.io</a
			>
		</div>
	</div>
</BaseLayout>
