---
import BaseLayout from "../layouts/BaseLayout.astro";
import { IDENTITY, SITE_METADATA } from "../constants.js";
import LinkButton from "../components/LinkButton.astro";
const pageTitle = "Games";
---

<BaseLayout pageTitle={pageTitle}>
	<h2 style="text-align:center;">My completed (& playable!) games:</h2>

	<div class="box-group">
		<!-- Welcome to the Dungeon Card -->
		<div class="pixel-box" style="max-width: 600px;">
			<h3>Welcome to the Dungeon</h3>
			<p>Solo Developer | Unity (3D C#)</p>
			<LinkButton name="Play now" url="/welcome-to-the-dungeon" />
			<p style="line-height: 1.5rem;">
				I created this game during my last
				semester as a Computer Science student at the University of
				Michigan (Fall 2020) for EECS 494: Intro to Game
				Development. It took roughly 2 weeks to build, and I
				leveraged open source assets which helped a ton, considering the short deadline. 
			</p>
			<p style="line-height: 1.5rem;">
				Fun fact: My parents and sister performed the voice acting for the perishing adventures! 
				...On that morbid note, good luck with the clean up!
			</p>
		</div>

		<!-- Star Witch Card -->
		<div class="pixel-box" style="max-width: 600px;">
			<h3>Star Witch</h3>
			<p>Engineer & Technical Art | Unity (2D C#)</p>
			<LinkButton
				name="View on Itch.io"
				url="https://lunarladiesstudio.itch.io/star-witch"
			/>
		</div>
	</div>
</BaseLayout>
