---
import BaseLayout from "../layouts/BaseLayout.astro";
import { IDENTITY, SITE_METADATA } from "../constants.js";
import castle from "../assets/images/castle.jpg"
import Image from "astro/components/Image.astro";
import * as intro from "../content/intro.md"

const pageTitle = "Home";

const landingTitle = `Welcome to ${IDENTITY.firstName}'s Domain!`;

const hobbies = {
	currentReads: ["Empire of Shadows by Jacquelyn Benson", "Iron Gold by Pierce Brown (audiobook)", "The Harry Dresden Files by Jim Butcher (audiobooks)"],
	currentGames: ["Night in the Woods", "Stardew Valley", "Witcher 3", "Spider-Man (replay)"],
	currentShows: ["Gravity Falls", "Smallville"],
};
---

<BaseLayout pageTitle={pageTitle}>
	<!-- Intro -->
	<div class="profile-container">
		<div class="profile-title">
		<h1>{landingTitle}</h1>
		</div>
		<div class="profile-columns">
			<Image
				src={castle}
				alt="Riley Schnee Portrait"
				class="profile-img"
			/>
			<div class="profile-text">
				<article class="prose">
					<intro.Content />
				</article>
			</div>
		</div>
	</div>

	<!-- Hobbies -->
	<div class="pixel-box" style="max-width: 500px;">
		<h2>In my free time...</h2>
		I enjoy exploring alternate and fantastical worlds! <br> Here's what I'm currently reading, watching, and playing...
		<br />
		{
			hobbies.currentReads.length !== 0 && (
				<h4>Books:</h4>
				<p>
					<ul>
						{hobbies.currentReads.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				</p>
			)
		}
		{
			hobbies.currentGames.length !== 0 && (
				<h4>Games:</h4>
				<p>
					<ul>
						{hobbies.currentGames.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				</p>
			)
		}
		{
			hobbies.currentShows.length !== 0 && (
				<h4>TV Shows:</h4>
				<p>
					<ul>
						{hobbies.currentShows.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				</p>
			)
		}
	</div>
</BaseLayout>

<style>

.profile-container {
    width: 100%;
    max-width: 1000px;
    margin: auto;
    margin-bottom: 30px;
    padding: 20px 20px 20px 20px;
    box-sizing: border-box;

}

.profile-title {
    margin-bottom: -15px;
    text-align: center;
    font-size: 1.5rem;
}

.profile-columns {
    display: flex;
    flex-direction: column;
    gap: 32px;
    margin: auto;
    max-width: 1050px;
    /* Note to self: Increase or decrease this depending on content! */
}

.profile-img {
    width: 100%;
    /* Fluid scaling on phone screens */
    max-width: 300px;
    height: auto;
    margin: auto;
    padding: 10px 10px 10px 10px;
    background-color: var(--brown);
    box-shadow: var(--cornerless-dropbox-border-med);
}

.profile-text {
    flex: 1;
    font-size: 1.1rem;
    line-height: 1.5;
	margin-top: -25px;
}

/* ==========================================
   3. ADAPTIVE DESKTOP LAYOUT (636px and up)
   ========================================== */
@media screen and (min-width: 636px) {
    .profile-columns {
        flex-direction: row;
        align-items: flex-start;
    }

    .profile-img {
        margin: 0;
        width: 300px;
    }
}
</style>